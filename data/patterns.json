{
  "version": 1,
  "patterns": [
    {
      "id": "claude_code_numbered_v4",
      "description": "Claude Code v2.1+ generic 3-option picker (approval / resume / その他)。option ラベルは検知時に画面から動的抽出するので、ここの options[] はフォールバック用デフォルト。",
      "regex": "❯\\s+1\\.[\\s\\S]{1,500}?^\\s+2\\.[\\s\\S]{1,500}?^\\s+3\\.",
      "flags": "m",
      "options": [
        { "label": "1", "keystroke": "1", "isDefault": true },
        { "label": "2", "keystroke": "2", "isDefault": false },
        { "label": "3", "keystroke": "3", "isDefault": false }
      ],
      "windowSize": 4096
    }
  ]
}
